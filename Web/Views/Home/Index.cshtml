                        <span class="product-tag">Verified Supplier</span>
                    </div>
                    <div class="product-content">
                        <span class="product-category">NUTS</span>
                        <h5>Cashew Nuts</h5>
                        <ul class="product-meta">
                            <li><i class="fa-solid fa-location-dot"></i>Ghana</li>
                            <li><i class="fa-solid fa-boxes-stacked"></i>MOQ: 40 MT</li>
                        </ul>
                        <a asp-controller="Marketplace" asp-action="Index" asp-route-q="Cashew Nuts" class="product-link">
                            View offers →
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="product-card">
                    <div class="product-image">
                        <img src="~/images/products/maize.jpg" alt="Yellow maize grains" loading="lazy" />
