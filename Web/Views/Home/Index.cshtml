<!-- FAQ (NEW) -->
<section class="section faq-section">
    <div class="container">
        <div class="section-heading text-center mx-auto">
            <span class="eyebrow">COMMON QUESTIONS</span>
            <h2>Frequently asked questions</h2>
            <p>Everything you need to know before starting your trade journey on Tijara.</p>
        </div>

        <div class="accordion faq-accordion" id="faqAccordion">
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        How do I know suppliers are verified?
                    </button>
                </h3>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Every supplier on Tijara goes through a business verification process including
                        identity checks, business registration, and trade history review.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        What is the minimum order quantity?
                    </button>
                </h3>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        MOQ varies by product and supplier. Each product listing shows the minimum order
                        quantity, and you can negotiate directly with suppliers.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        How are payments handled?
                    </button>
                </h3>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Payments follow agreed terms in a structured trade agreement. Both parties can
                        track milestones and release funds based on delivery progress.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                        Can I ship internationally?
                    </button>
                </h3>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Yes. Tijara supports cross-border trade with logistics partners in multiple regions.
                        Shipping and delivery terms are agreed per trade.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                        Is Tijara free to use?
                    </button>
                </h3>
                <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Creating an account and exploring the marketplace is free. Transaction fees are
                        outlined transparently for sellers when listing and closing trades.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SUPPLIER CTA -->
<section class="supplier-section">
    <div class="container">
        <div class="supplier-content">
            <span class="eyebrow">FOR AFRICAN BUSINESSES</span>
            <h2>Take your agricultural business to new markets.</h2>
            <p>Connect with potential buyers, showcase your products, and create new opportunities for your business.</p>
            <div class="supplier-actions">
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                    Start Selling on Tijara →
                </a>
                <a asp-controller="Marketplace" asp-action="Index" class="btn supplier-outline-btn btn-lg">
                    Explore Marketplace
                </a>
            </div>
        </div>
    </div>
</section>

<!-- FINAL CTA -->
<section class="final-cta">
    <div class="container text-center">
        <span class="eyebrow">YOUR NEXT TRADE STARTS HERE</span>
        <h2>Let's connect African trade to global opportunities.</h2>
        <p>Whether you're sourcing agricultural products or looking for new markets, Tijara is the place to start.</p>
        <a asp-controller="Marketplace" asp-action="Index" class="btn btn-primary-custom btn-lg">
            Explore Tijara →
        </a>
    </div>
</section>