                    </div>
                    <div class="product-content">
                        <span class="product-category">GRAINS</span>
                        <h5>Maize</h5>
                        <ul class="product-meta">
                            <li><i class="fa-solid fa-location-dot"></i>Kenya</li>
                            <li><i class="fa-solid fa-boxes-stacked"></i>MOQ: 20 MT</li>
