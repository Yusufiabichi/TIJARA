@{
    ViewData["Title"] = "African Trade, Connected Globally";
}

<!-- HERO -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <span class="eyebrow">AFRICAN AGRICULTURAL TRADE</span>

                <h1 class="hero-title">
                    African trade,<br />
                    <span>connected globally.</span>
                </h1>

                <p class="hero-description">
                    Source verified agricultural products, connect with trusted suppliers and buyers,
                    and manage cross-border trade with confidence.
                </p>

                <div class="hero-actions">
                    <a asp-controller="Marketplace" asp-action="Index" class="btn btn-primary-custom btn-lg">
                        Explore Marketplace <span>→</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom btn-lg">
                        Become a Supplier
                    </a>
                </div>

                <div class="hero-highlights">
                    <div><span class="highlight-icon"><i class="fa-solid fa-circle-check"></i></span>Verified Suppliers</div>
                    <div><span class="highlight-icon"><i class="fa-solid fa-shield-halved"></i></span>Structured Transactions</div>
                    <div><span class="highlight-icon"><i class="fa-solid fa-earth-africa"></i></span>Global Reach</div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-image-wrapper">
                    <img src="~/images/hero2.jpg" asp-append-version="true"
                         alt="African agricultural commodities ready for trade" class="hero-image" />
                    <div class="hero-image-card">
                        <div class="hero-card-icon">
                            <i class="fa-solid fa-earth-africa"></i>
                        </div>
                        <div>
                            <strong>Trade without borders</strong>
                            <p>Connecting African businesses to global markets.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS STRIP (Social Proof) -->
<section class="stats-strip">
    <div class="container">
        <div class="row text-center gy-4">
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <strong>500+</strong>
                    <span>Verified Suppliers</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <strong>30+</strong>
                    <span>Countries Connected</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <strong>10,000+</strong>
                    <span>Trade Connections</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <strong>100%</strong>
                    <span>Structured Transactions</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TRUST STRIP -->
<section class="trust-strip">
    <div class="container">
        <div class="row gy-3 text-center">
            <div class="col-6 col-md-3"><div class="trust-item"><span><i class="fa-solid fa-wheat-awn"></i></span><strong>Agricultural Products</strong></div></div>
            <div class="col-6 col-md-3"><div class="trust-item"><span><i class="fa-solid fa-handshake"></i></span><strong>Business Connections</strong></div></div>
            <div class="col-6 col-md-3"><div class="trust-item"><span><i class="fa-solid fa-shield-halved"></i></span><strong>Structured Trade</strong></div></div>
            <div class="col-6 col-md-3"><div class="trust-item"><span><i class="fa-solid fa-earth-africa"></i></span><strong>Global Opportunities</strong></div></div>
        </div>
    </div>
</section>

<!-- CATEGORIES -->
<section class="section categories-section">
    <div class="container">
        <div class="section-heading d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <span class="eyebrow">EXPLORE THE MARKETPLACE</span>
                <h2>Discover agricultural products</h2>
                <p>Explore commodities and connect with businesses offering the products you need.</p>
            </div>
            <a asp-controller="Marketplace" asp-action="Index" class="section-link">View all products →</a>
        </div>

        <div class="row g-4">
            <div class="col-6 col-lg-3">
                <a asp-controller="Marketplace" asp-action="Index" asp-route-category="Grains" class="category-card">
                    <div class="category-image"><img src="~/images/grains.jpg" alt="Grains and cereals" loading="lazy" /></div>
                    <div class="category-info"><h5>Grains & Cereals</h5><span>Explore products →</span></div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Marketplace" asp-action="Index" asp-route-category="Spices" class="category-card">
                    <div class="category-image"><img src="~/images/spices.jpg" alt="Agricultural spices" loading="lazy" /></div>
                    <div class="category-info"><h5>Spices</h5><span>Explore products →</span></div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Marketplace" asp-action="Index" asp-route-category="Nuts" class="category-card">
                    <div class="category-image"><img src="~/images/nuts.jpg" alt="Agricultural nuts" loading="lazy" /></div>
                    <div class="category-info"><h5>Nuts & Seeds</h5><span>Explore products →</span></div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Marketplace" asp-action="Index" asp-route-category="CashCrops" class="category-card">
                    <div class="category-image"><img src="~/images/cash-crop.jpg" alt="Cash crops" loading="lazy" /></div>
                    <div class="category-info"><h5>Cash Crops</h5><span>Explore products →</span></div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED PRODUCTS -->
